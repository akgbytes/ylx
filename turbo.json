{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "env": ["GOCACHE"],
      "outputs": ["bin/**", "dist/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "format": {
      "cache": false
    },
    "lint": {
      "env": ["GOCACHE"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "env": ["GOCACHE"]
    }
  }
}
