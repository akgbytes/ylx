{
  "name": "ylx",
  "private": true,
  "author": "akgbytes",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo run clean && rimraf .turbo",
    "commitlint": "commitlint --edit",
    "dev": "turbo dev",
    "format": "prettier --ignore-unknown --write . && turbo format",
    "format:check": "prettier --ignore-unknown --check . && turbo format:check",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
